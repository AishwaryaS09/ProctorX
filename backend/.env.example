# ============================================
# ProctorX Backend - environment variables
# Copy to .env and fill in real values.
# ============================================

# Server
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# MongoDB (local default; use Atlas URI for cloud)
MONGO_URI=mongodb://127.0.0.1:27017/proctorx

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=8h
JWT_COOKIE_NAME=proctorx_token

# Python AI service URL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=5000

# Seed admin (used by npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@proctorx.dev
ADMIN_FULL_NAME=Platform Administrator

# Client URL (CORS)
CLIENT_URL=http://127.0.0.1:5173

# Evidence screenshots
SCREENSHOT_ENABLED=true
EVIDENCE_DIR=./uploads/evidence

# Monitoring behaviour (keep in sync with python-ai-service defaults)
WARNING_LEVELS=1,2,3
AUTO_END_THRESHOLD=3
SCREENSHOT_SEVERITY_BELOW=MEDIUM
